{
  "apiVersion": 1,
  "id": "volcengine-ark",
  "name": "OpenAI 兼容多模态回复服务",
  "version": "1.1.0",
  "entry": "provider.bundle.js",
  "moduleType": "module",
  "capabilities": ["chat"],
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "password",
        "title": "回复模型 API Key",
        "description": "独立于视觉定位模型的密钥；旧配置为空时仍可回退使用视觉密钥。"
      },
      "baseURL": {
        "type": "string",
        "format": "uri",
        "title": "Base URL",
        "default": "https://ark.cn-beijing.volces.com/api/v3",
        "description": "可填写 API 根地址，也可直接填写完整的 /chat/completions 地址。"
      },
      "model": {
        "type": "string",
        "title": "模型名称",
        "default": "doubao-seed-2-0-lite-260215",
        "description": "回复请求包含聊天截图，因此模型必须支持图片输入。"
      },
      "systemPrompt": {
        "type": "string",
        "title": "系统提示词",
        "default": ""
      }
    },
    "required": ["apiKey", "baseURL", "model"]
  }
}